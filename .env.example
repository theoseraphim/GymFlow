# URL do projeto Supabase
# Encontre em: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon do Supabase (segura para expor no frontend)
# Encontre em: Supabase Dashboard > Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# IMPORTANTE: a chave da IA (OpenRouter) NÃO fica aqui.
# Ela é um secret no servidor, usado apenas pela Edge Function `ai-insight`.
# Configure com:
#   supabase secrets set OPENROUTER_API_KEY="sua-chave-openrouter"
